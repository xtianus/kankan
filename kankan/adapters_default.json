        ]
      },
      "gpt-5.6-luna": {
        "efforts": [
          "max",
          "xhigh",
          "high",
          "medium",
          "low"
        ]
      }
    },
    "models_from": {
      "command": [
        "codex",
        "debug",
        "models"
      ],
      "file": "{CODEX_HOME}/models_cache.json"
    },
    "model_check": [
      "codex",
      "exec",
      "--ephemeral",
      "--skip-git-repo-check",
      "--model",
      "{model}",
      "-c",
      "model_reasoning_effort=\"{effort}\"",
      "Reply OK"
    ],
    "model_check_home": {
      "env": "CODEX_HOME",
      "files": [
        "auth.json"
      ]
    },
    "restart_keep": [
      "\\bcodex\\s+app-server\\b.*--managed-daemon\\b"
    ]
  }
}
