#!/bin/sh
# kankan pre-push hook: refuses to publish refs/agent-* (they contain host, user and paths) and refuses pushes to
# the agents' integration branch except from `kankan integrate` (KANKAN_PUSH=1): only kankan moves that branch.
# Installed by `kankan init`. Remove refs published by mistake with `kankan purge-remote`.
integration=$(git config --get kankan.integrationBranch)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/agent-*) echo "kankan: refusing to push $local_ref (kankan refs must stay local)" >&2; status=1 ;;
    esac
    case "$remote_ref" in
        refs/agent-*) echo "kankan: refusing to push to $remote_ref (kankan refs must stay local)" >&2; status=1 ;;
    esac
    if [ -n "$integration" ] && [ "$remote_ref" = "refs/heads/$integration" ] && [ "${KANKAN_PUSH:-}" != "1" ]; then
        echo "kankan: refusing to push to $remote_ref: only kankan moves $integration (use kankan merge-request)" >&2
        status=1
    fi
done
exit $status
